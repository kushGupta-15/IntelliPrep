NEXT_PUBLIC_DATABASE_CONNECTION_STRING=YOUR_POSTGRES_CONNECTION_URL
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=your_clerk_secret_key

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI — only Groq is used. OpenAI keys are NOT required.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_ID=llama-3.3-70b-versatile

# Razorpay — OPTIONAL. App works without these; payment buttons show "coming soon".
# Get keys from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Inngest ───────────────────────────────────────────────────────────────────
# LOCAL DEV  → INNGEST_DEV=1, both keys = "local"
#              run: npx inngest-cli@latest dev -u http://localhost:3000/api/inngest
#
# PRODUCTION → remove INNGEST_DEV, use real keys from app.inngest.com
#   Event Key   → app.inngest.com > Settings > Event Keys
#   Signing Key → app.inngest.com > Settings > Signing Keys (starts with signkey-prod-...)
# ──────────────────────────────────────────────────────────────────────────────
INNGEST_DEV=1
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

# Local SQLite fallback for development when remote database is unavailable
# Set USE_LOCAL_SQLITE=1 to use a local SQLite file instead of Neon.
# LOCAL_SQLITE_PATH=./dev.sqlite
